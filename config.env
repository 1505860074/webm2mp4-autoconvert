# ============================================================
#  webm2mp4-autoconvert 的“配置中心”
#  想改行为？只改这一个文件，然后重新跑 ./install.sh 即可生效。
#
#  说明：这个文件会被 install.sh 用 bash 的 `source` 命令读入，
#        所以它就是普通的 bash 变量赋值，可以用 $HOME 这种写法。
# ============================================================

# ---- 转码脚本的行为参数 ----
WATCH_DIR="$HOME/Videos"   # 监控哪个文件夹（GNOME 录屏默认存这里）
INTERVAL=5                 # 每隔几秒扫一次文件夹
STABLE_AGE=8              # 文件“几秒没变化”才算录制完成（防止录到一半就转）
DELETE_ORIGINAL=0        # 转成 mp4 后是否删掉原 .webm：1=删，0=保留。【保守默认=0，原文件不删】
RETENTION_DAYS=0         # 只保留最近多少天的视频，超过就删。【保守默认=0，表示彻底关闭自动清理】
                         #   想开启就填正整数，例如 7 = 只留最近 7 天（⚠️ 会自动删旧视频，见 README）

# ---- GNOME 桌面录屏设置（安装时会用 gsettings 写回系统）----
MAX_SCREENCAST_LENGTH=1800                 # 单次最长录屏时长（秒）。1800 = 30 分钟
SCREENCAST_SHORTCUT="['<Ctrl><Shift><Alt>R']"   # 录屏开关快捷键（GNOME 默认值）
